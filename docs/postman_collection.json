            "header": [
              {
                "key": "User_Token",
                "value": "{{user_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Updated Department",
                  "type": "text"
                },
                {
                  "key": "node_type",
                  "value": "department",
                  "type": "text"
                },
                {
                  "key": "uid",
                  "value": "{{uid}}",
                  "type": "text"
                },
                {
                  "key": "hashid",
                  "value": "{{hashid}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/chart/edit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chart",
                "edit"
              ]
            }
          }
        },
        {
          "name": "Move Chart Node",
          "request": {
            "method": "PUT",
            "header": [
