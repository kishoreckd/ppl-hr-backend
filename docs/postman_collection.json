            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "uid",
                  "value": "{{uid}}",
                  "type": "text"
                },
                {
                  "key": "hashid",
                  "value": "{{hashid}}",
                  "type": "text"
                },
                {
                  "key": "parent_hashid",
                  "value": "{{parent_hashid}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/chart/move_node",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chart",
                "move_node"
              ]
