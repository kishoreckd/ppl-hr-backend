        {
          "name": "Get Charts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "User_Token",
                "value": "{{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chart/?page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chart"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Create Chart Node",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "User_Token",
                "value": "{{user_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Company",
                  "type": "text"
                },
                {
                  "key": "node_type",
                  "value": "department",
                  "type": "text"
                },
                {
                  "key": "person",
                  "value": "{\"title\": \"CEO\", \"email\": \"ceo@example.com\"}",
                  "type": "text"
                },
                {
                  "key": "uid",
                  "value": "{{uid}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/chart/create",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chart",
                "create"
              ]
            }
          }
        },
        {
          "name": "Get Chart by UID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "User_Token",
                "value": "{{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chart/get/{{uid}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chart",
                "get",
                "{{uid}}"
              ]
            }
          }
        },
        {
          "name": "Get Shared Chart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "User_Token",
                "value": "{{share_token}}"
              },
              {
                "key": "Guest_token",
                "value": "{{guest_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chart/share/{{uid}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chart",
                "share",
                "{{uid}}"
              ]
            }
          }
        },
        {
          "name": "Edit Chart Node",
          "request": {
